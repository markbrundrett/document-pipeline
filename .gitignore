# Claude Code may store local credentials/auth state alongside project files.
# Skills themselves (.claude/skills/) are meant to be committed — only ignore
# local machine state, not the skill definitions.
.claude/.credentials.json
.claude/settings.local.json

# Spec Kit per-checkout state (see .specify/.gitignore for details)
.specify/feature.json
.specify/extensions/*/local-config.yml

# Structurizr static export output (regenerated by CI, not committed)
architecture/site/

# OS/editor noise
.DS_Store
*.swp

# Never commit credentials dropped at the repo root during local auth setup
token
*.token
.env
.env.*
