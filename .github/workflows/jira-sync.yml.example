# Jira sync — inactive by default (this file has a .example suffix so GitHub Actions
# ignores it). Two ways to activate it:
#
# Option A — this Action (needs Jira API credentials as repo secrets):
#   1. Rename to jira-sync.yml
#   2. Add repo secrets: JIRA_BASE_URL, JIRA_EMAIL, JIRA_API_TOKEN, JIRA_PROJECT_KEY
#   3. Fill in the "Create/update Jira issues" step below with your team's field mapping
#      (issue type, epic link, labels, etc.) — every Jira instance's required fields differ.
#
# Option B — ask Claude directly. If your org has authorized the Atlassian connector
# (claude.ai connector settings), Claude can read tasks.md and create/update the matching
# Jira issues in conversation, no Action needed. Simpler to start with; this file is here
# for when you want it to run unattended on every push instead.
#
# Either way, tasks.md stays the source of truth (per the constitution's Jira Convention:
# Architecture Constraints table + the Jira Convention section in
# .specify/templates/tasks-template.md). Jira is a mirror, not the record.

name: Jira sync

on:
  push:
    branches: [main]
    paths:
      - "specs/**/tasks.md"
  workflow_dispatch:

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Create/update Jira issues from tasks.md
        run: |
          echo "TODO: parse specs/**/tasks.md for tasks without a [JIRA-xxx] prefix,"
          echo "create issues via the Jira REST API (POST /rest/api/3/issue), and"
          echo "commit the returned keys back into tasks.md."
          echo "See: https://developer.atlassian.com/cloud/jira/platform/rest/v3/"
        env:
          JIRA_BASE_URL: ${{ secrets.JIRA_BASE_URL }}
          JIRA_EMAIL: ${{ secrets.JIRA_EMAIL }}
          JIRA_API_TOKEN: ${{ secrets.JIRA_API_TOKEN }}
          JIRA_PROJECT_KEY: ${{ secrets.JIRA_PROJECT_KEY }}
